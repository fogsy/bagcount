EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
# Set to 1 to classify punch peaks with Jev
EXPO_PUBLIC_JEV_PUNCH_CLASSIFY=1
# Debug: call OpenRouter from the app (skips Firebase). Dev only — key is in the bundle.
EXPO_PUBLIC_JEV_PUNCH_DEBUG=1
EXPO_PUBLIC_OPENROUTER_API_KEY=

# Production path (when DEBUG=0): Firebase callable holds the secret
#   firebase functions:secrets:set OPENROUTER_API_KEY
# OPENROUTER_API_KEY=
