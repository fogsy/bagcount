rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['lastSubmitXp', 'lastSubmitAt']);
    }

    match /weeks/{weekId}/scores/{uid} {
      allow read: if true;
      allow write: if false; // scores only via Cloud Functions Admin SDK
    }

    match /archives/{weekId} {
      allow read: if true;
      allow write: if false;
    }

    match /meta/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
